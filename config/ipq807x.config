# 基础配置（适配 IPQ807x 芯片）
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y  # RA69/AX6 通用，stock 原生分区

# 必选组件（解决你的核心需求）
CONFIG_PACKAGE_wireguard-tools=y  # 内置 wireguard-tools，无需后续安装
CONFIG_PACKAGE_luci-app-openclash=y  # 内置 OpenClash
CONFIG_PACKAGE_kmod-tun=y  # 内置 TUN 模块（WireGuard 核心）

# NSS 硬件加速（RA69 满血功能）
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y

# 基础工具（避免后续缺依赖）
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_sshfs=y
